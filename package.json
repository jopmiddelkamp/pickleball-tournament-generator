{
  "name": "pickleball-tournament-generator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "bench": "pnpm --filter @ptg/bench run bench",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:env": "node scripts/local-env.mjs",
    "db:studio": "node scripts/local-env.mjs --studio",
    "db:generate": "pnpm --filter @ptg/generator run db:generate",
    "db:migrate": "pnpm --filter @ptg/generator run db:migrate",
    "db:migrate:cloud": "pnpm --filter @ptg/generator run db:migrate:cloud",
    "db:seed": "turbo run seed --filter=@ptg/generator",
    "db:reset": "supabase db reset --no-seed && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
