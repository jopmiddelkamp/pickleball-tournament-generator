{
  "name": "pickleball-tournament-generator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "bench": "pnpm --filter @ptg/bench run bench",
    "db:start": "sh -c 'set -a; [ -f supabase/.env ] && . supabase/.env; supabase start'",
    "db:stop": "supabase stop",
    "db:env": "node scripts/local-env.mjs",
    "db:studio": "node scripts/local-env.mjs --studio",
    "db:generate": "pnpm --filter @ptg/generator run db:generate",
    "db:migrate": "pnpm --filter @ptg/generator run db:migrate",
    "db:migrate:cloud": "pnpm --filter @ptg/generator run db:migrate:cloud",
    "db:seed": "turbo run seed --filter=@ptg/generator",
    "db:reset": "sh -c 'set -a; [ -f supabase/.env ] && . supabase/.env; supabase db reset --no-seed' && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.11.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
