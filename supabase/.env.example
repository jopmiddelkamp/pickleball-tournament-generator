# Google OAuth client for local organiser sign-in (supabase/config.toml reads
# these through env()). Copy to supabase/.env — which is git-ignored — and fill
# in the values from your Google Cloud OAuth client. The hosted project gets
# them via the Supabase dashboard instead; nothing is needed on Vercel.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
